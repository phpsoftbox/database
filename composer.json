{
    "name": "phpsoftbox/database",
    "description": "DBAL component for the PhpSoftBox framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton K.",
            "email": "inspector-who@mail.ru"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "phpsoftbox/database-lookup": "^1.0",
        "phpsoftbox/error-formatter": "^1.0",
        "phpsoftbox/inflector": "^1.0",
        "phpsoftbox/pagination": "^1.0",
        "phpsoftbox/profiler": "^1.0",
        "phpsoftbox/validator-db": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpsoftbox/cli-app": "^1.0",
        "phpsoftbox/cs-fixer": "^1.2.2",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\Database\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\Database\\Tests\\": "tests/"
        }
    },
    "extra": {
        "psb": {
            "providers": [
                "PhpSoftBox\\Database\\Cli\\DatabaseCommandProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff"
    },
    "prefer-stable": true
}
